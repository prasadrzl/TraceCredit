# ─── Deployer ────────────────────────────────────────────────────────────────
# Private key of the deployer wallet — NEVER commit a real key
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ─── Protocol Addresses ───────────────────────────────────────────────────────
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS
KEEPER_ADDRESS=0xYOUR_KEEPER_BOT_ADDRESS
ATTESTOR_ADDRESS=0xYOUR_FIRST_ATTESTOR_ADDRESS
QUORUM=2

# ─── Token Addresses ─────────────────────────────────────────────────────────
# Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0xYOUR_USDC_ADDRESS

# ─── RPC Endpoints ───────────────────────────────────────────────────────────
BASE_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://sepolia.drpc.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ─── Block Explorer API Keys ─────────────────────────────────────────────────
# basescan.org → My Account → API Keys
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

NODE_ENV=development
PORT=3001

# ─── Keeper / Indexer ─────────────────────────────────────────────────────────
KEEPER_ENABLED=false

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/tracecredit_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Chain ────────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# ─── Contracts (fill in after deployment) ────────────────────────────────────
LENDING_POOL_ADDRESS=0xYOUR_LENDING_POOL
REPUTATION_SBT_ADDRESS=0xYOUR_REPUTATION_SBT
SCORE_ENGINE_ADDRESS=0xYOUR_SCORE_ENGINE
CREDIT_LINE_MANAGER_ADDRESS=0xYOUR_CREDIT_LINE_MANAGER
LIQUIDATION_MANAGER_ADDRESS=0xYOUR_LIQUIDATION_MANAGER
ATTESTATION_BRIDGE_ADDRESS=0xYOUR_ATTESTATION_BRIDGE
WHITELIST_REGISTRY_ADDRESS=0xYOUR_WHITELIST_REGISTRY
RESERVE_MODULE_ADDRESS=0xYOUR_RESERVE_MODULE
FEE_COLLECTOR_ADDRESS=0xYOUR_FEE_COLLECTOR
SBT_STAKE_VAULT_ADDRESS=0xYOUR_SBT_STAKE_VAULT
RATE_LIMITER_ADDRESS=0xYOUR_RATE_LIMITER
INTEREST_ACCRUAL_ENGINE_ADDRESS=0xYOUR_INTEREST_ACCRUAL_ENGINE
# Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0xYOUR_USDC

# ─── Price Feed ───────────────────────────────────────────────────────────────
# Base Sepolia:  0x16a9Fa2fda030272ce99b29CF780dfA30361D6b9
# Base Mainnet:  0x7e860098F58bBFC8648a4311b374B1D669a2bc9b
CHAINLINK_USDC_USD_FEED=0xYOUR_CHAINLINK_FEED

# ─── The Graph ────────────────────────────────────────────────────────────────
SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_SUBGRAPH_ID/tracecredit/version/latest

# ─── Liquidation Bot ──────────────────────────────────────────────────────────
# Never commit a real private key — use a secrets manager in production
LIQUIDATION_BOT_PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY

# ─── EAS / Attestation ───────────────────────────────────────────────────────
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
EAS_SCHEMA_UID=0xYOUR_SCHEMA_UID

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-minimum-32-characters-long

# ─── Rate Limiter ─────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ─── Protocol Parameters ─────────────────────────────────────────────────────
SBT_STAKE_USDC=50
SBT_UNLOCK_DAYS=30
SIGNAL_DECAY_DAYS=90
SIGNAL_EXPIRY_WARNING_DAYS=14
LIMIT_INCREASE_DAYS=30
